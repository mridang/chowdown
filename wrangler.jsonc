{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chowdown",
  "main": "src/worker.ts",
  "account_id": "779037e608ab1102679ef8b1bd499d49",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare auto-routes the Worker to the colo closest to D1
  // (avoids the worst-case ~70 ms hop). Free on all plans.
  "placement": { "mode": "smart" },
  // Full Workers Observability: logs, metrics, invocation traces — all
  // sampled at 100% (the volume is tiny, the data is gold for debugging).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
  // Custom domain — the workers.dev subdomain is disabled so the
  // canonical URL is the one we control. The apps.mrida.ng zone must be
  // attached to this Cloudflare account for the custom_domain bind to
  // succeed.
  "workers_dev": false,
  "routes": [{ "pattern": "chowdown.apps.mrida.ng", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    // Built files go through the Worker so it can answer scripts and styles with
    // their brotli copies (see src/lib/http/precompressed.ts). All other static
    // files are still served without waking the Worker.
    "run_worker_first": ["/_next/static/*"],
  },
  // Workers AI — used server-side to convert fetched recipe content into
  // Cooklang under our control (the client passes raw page text/HTML, never
  // the Cooklang itself). Free daily allocation covers hobby volume.
  "ai": {
    "binding": "AI",
  },
  // Scales recipe cover photos down (and re-encodes them as WebP) in the Worker.
  // Free monthly allowance; see src/lib/images/cover-proxy.ts.
  "images": {
    "binding": "IMAGES",
  },
  // The release id, so cached pages are keyed to the release that made them.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chowdown-db",
      // Create with `wrangler d1 create chowdown-db` and paste the id here.
      "database_id": "a671876a-08e1-4e34-8ee5-9bd6222169cc",
      "migrations_dir": "migrations",
    },
  ],
}
