{
  "openapi": "3.1.0",
  "info": {
    "title": "chowdown API",
    "version": "0.1.0",
    "description": "REST API of chowdown. Errors are application/problem+json (RFC 9457). Every response carries X-Flow-ID. Redirect flows (/auth/*), OAuth (/oauth/*), MCP (/mcp), /health, /img and /csp/reports are not part of this contract."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/recipes": {
      "get": {
        "summary": "List recipes",
        "tags": ["recipes"],
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "200": {
            "description": "A page of recipes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["self", "items"],
                  "properties": {
                    "self": {
                      "type": "string",
                      "format": "uri"
                    },
                    "next": {
                      "type": "string",
                      "format": "uri"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RecipeSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/cursor"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "title or modified_at, optionally prefixed with + or -."
            }
          },
          {
            "name": "source_site",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Create a recipe",
        "tags": ["recipes"],
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "200": {
            "description": "The recipe already exists (its source link is saved).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Absolute URL of the resource.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Absolute URL of the resource.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "ETag": {
                "description": "Entity tag of the representation.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "cooklang"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "cooklang": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
