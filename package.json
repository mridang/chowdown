{
  "name": "chowdown",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certs/chowdown.dev.mrida.ng-key.pem --experimental-https-cert ./certs/chowdown.dev.mrida.ng.pem -H chowdown.dev.mrida.ng -p 443",
    "typecheck": "tsc --noEmit",
    "build:views": "node scripts/build-views.mjs",
    "build": "node scripts/build-views.mjs && next build",
    "start": "next start",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "cert:dev": "mkdir -p certs && openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/chowdown.dev.mrida.ng-key.pem -out certs/chowdown.dev.mrida.ng.pem -days 825 -subj '/CN=chowdown.dev.mrida.ng' -addext 'subjectAltName=DNS:chowdown.dev.mrida.ng'",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:watch": "npm run test -- --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "conformance": "node scripts/conformance/run.mjs"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cooklang/cooklang-ts": "^1.2.8",
    "@opennextjs/cloudflare": "^1.20.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.5.2",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@mridang/eslint-defaults": "^1.6.3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.86.0"
  }
}
