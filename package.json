{
  "name": "chowdown",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certs/chowdown.dev.mrida.ng-key.pem --experimental-https-cert ./certs/chowdown.dev.mrida.ng.pem -H chowdown.dev.mrida.ng -p 443",
    "build:views": "node scripts/build-views.mjs",
    "build": "node scripts/build-views.mjs && next build",
    "start": "next start",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "cert:dev": "mkdir -p certs && openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/chowdown.dev.mrida.ng-key.pem -out certs/chowdown.dev.mrida.ng.pem -days 825 -subj '/CN=chowdown.dev.mrida.ng' -addext 'subjectAltName=DNS:chowdown.dev.mrida.ng'",
    "deploy": "opennextjs-cloudflare build && node scripts/optimize-assets.mjs && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:watch": "npm run test -- --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cooklang/cooklang-ts": "^1.1.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "^1.6.3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^14.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "miniflare": "4.20260603.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.86.0"
  }
}
