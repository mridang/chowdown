{
  "name": "chowdown",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:views && next build",
    "build:views": "node scripts/build-views.mjs",
    "cf-typegen": "wrangler types && prettier --write worker-configuration.d.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "deploy": "wrangler d1 migrations apply DB --remote && opennextjs-cloudflare build && wrangler deploy",
    "dev": "next dev --port 3737",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run build:views",
    "lint": "npx eslint .",
    "prelint:fix": "npm run build:views",
    "lint:fix": "npx eslint . --fix",
    "migrate": "wrangler d1 migrations apply DB --local",
    "start": "next start",
    "pretest": "npm run build:views",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch",
    "pretypecheck": "npm run build:views",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare-workers",
    "cooklang",
    "google-drive",
    "mcp",
    "nextjs",
    "opennext",
    "pwa",
    "recipes"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "license": "Apache-2.0",
  "description": "A recipe app that keeps every recipe as a plain Cooklang file in your own Google Drive, with an MCP server for ChatGPT and Claude.",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/chowdown.git"
  },
  "homepage": "https://github.com/mridang/chowdown",
  "bugs": "https://github.com/mridang/chowdown/issues",
  "dependencies": {
    "@cooklang/cooklang-ts": "^1.1.2",
    "@opennextjs/cloudflare": "^1.20.12",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.14",
    "next": "16.4.2",
    "nuqs": "^2.10.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@mridang/eslint-defaults": "file:../../../../../../../../private/tmp/claude-501/-Users-mridang-Code-mridang-eslint-defaults--claude-worktrees-jolly-nobel-b54514/5d85ee26-5030-436a-b806-a5058404a92f/scratchpad/pack/mridang-eslint-defaults-2.0.1.tgz",
    "@tailwindcss/postcss": "^4",
    "@tsconfig/node24": "^24.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-drizzle": "^0.2.3",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@eslint/core": "1.2.1",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
